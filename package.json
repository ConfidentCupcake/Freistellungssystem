{
  "name": "btzfreistellungen",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=./bin --watch-path=./lib --watch-path=./routes --watch-path=./app.js ./bin/www",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node ./bin/www",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node ./scripts/migrate.js",
    "seed": "node ./scripts/seed-user.js",
    "test": "node --test"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "node-pg-migrate": "^9.0.0",
    "vite": "^7.1.0"
  }
}

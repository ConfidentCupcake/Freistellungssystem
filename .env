# Copy to .env and fill in. .env is gitignored; this file is committed.
# Real environment variables set by the shell or host override anything here.

# Port the Express server listens on. The Vite dev server (:5173) reads this
# too, so its /api proxy keeps pointing at the right place.
PORT=3000

# 'development' exposes error stacks in API responses and turns off the secure
# cookie flag. Set to 'production' when deploying.
NODE_ENV=development

# Postgres connection string. The value below matches docker-compose.yml, which
# `npm run db:up` starts for local development. Both the app and the migrations
# read this. Add ?sslmode=require against a managed database.
DATABASE_URL=postgres://btz:btz@localhost:5432/btzfreistellungen

# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it a new secret is generated per boot, invalidating every session on
# restart. Required in production.
SESSION_SECRET=node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# The account created by `npm run seed`. Defaults to admin/admin with a
# warning if unset. Re-running the seed resets that account's password.
LOGIN_USER=admin
LOGIN_PASSWORD=admin
# Optional. Set it and the seeded admin can sign in with this address as well as
# with LOGIN_USER; leave it empty and the account just has no address.
LOGIN_EMAIL=

# Uncomment to see the debug() logging from bin/www.
#DEBUG=btzfreistellungen:*
